# GlitchTip environment. Copy to .env, fill in the secrets, and
# DO NOT commit the populated .env. /opt/glitchtip/.env on the
# services box is the canonical location.
#
# Generate strong secrets:
#   openssl rand -hex 32          # SECRET_KEY, POSTGRES_PASSWORD
#

# --- Required: Django secret + Postgres ---
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_DB=glitchtip
# GlitchTip reads DATABASE_URL; keep host/port matching the service name.
DATABASE_URL=postgres://glitchtip:REPLACE_WITH_openssl_rand_hex_32@postgres:5432/glitchtip

# --- Required: public-facing URL ---
# Used in invite emails, OAuth callbacks, and CSRF origin checks.
# Must match the host clients connect to (i.e. the nginx vhost).
GLITCHTIP_DOMAIN=https://glitchtip.glassmkr.com
DEFAULT_FROM_EMAIL=glitchtip@glassmkr.com

# --- Required: Redis ---
REDIS_URL=redis://redis:6379/0

# --- Recommended: tighten signup so the install isn't a public service ---
# After you've created your admin account on first run, set this to
# `false` to prevent anyone else from registering. New users get
# invited from the GlitchTip admin UI instead.
ENABLE_USER_REGISTRATION=true
ENABLE_ORGANIZATION_CREATION=false

# --- Email (so GlitchTip can send invites + alert digests) ---
# Use the existing Glassmkr Postfix relay on localhost or wire to
# Resend / Mailgun. EMAIL_URL is the simplest form.
#
# Examples:
#   EMAIL_URL=smtp://user:password@mail.example.com:587/?tls=true
#   EMAIL_URL=consolemail://             (writes to container stdout; dev only)
EMAIL_URL=consolemail://

# --- Optional: GlitchTip version pin (default tracks v4.2) ---
# Pin a digest in prod once you've verified an upgrade. Bump
# deliberately, not on autorefresh.
# GLITCHTIP_VERSION=v4.2

# --- Optional: ingest rate / retention tuning ---
# Defaults are sane for a small install. Re-visit if you start
# receiving > 10k events/day.
# CELERY_WORKER_AUTOSCALE=1,3
# GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
