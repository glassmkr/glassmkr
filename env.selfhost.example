# Glassmkr self-hosted configuration. Copy this file to .env, then run
# ./scripts/selfhost-setup.sh to fill in the secrets, then docker compose up -d.
#
# Every secret below ships with the literal placeholder CHANGE_ME. That is
# deliberate: Compose interpolates variables for EVERY subcommand, so a file
# with missing values makes even `docker compose down` fail to parse, before
# you have run setup. Placeholders keep the file parseable at all times, and
# the stack refuses to start while any of them is still CHANGE_ME.

# Generated by ./scripts/selfhost-setup.sh. Distinct secrets on purpose: the
# application role must not be able to administer the database, or the
# append-only audit log would be decorative.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME

# Signing key for session tokens. Generated by setup. Changing it logs everyone
# out, which is the intended lever if you ever need to revoke every session.
JWT_SECRET=CHANGE_ME

# Pepper for API-key hashing. Generated by setup. Never change it after first
# boot: changing it invalidates every key ever issued by this instance.
GLASSMKR_KEY_PEPPER=CHANGE_ME

# The URL agents and browsers use to reach this dashboard. For a LAN install
# use the host's address, e.g. http://10.0.0.5:3000
# The address AGENTS use to reach this dashboard, not the address you type in
# your browser. It is handed to every agent you enrol as its ingest URL, so on a
# multi-host install localhost is wrong and nothing will ever arrive.
#
# It has to agree with DASHBOARD_BIND below. scripts/selfhost-setup.sh derives
# it from that setting; override here if your agents reach the dashboard by a
# DNS name or through a reverse proxy.
DASHBOARD_PUBLIC_URL=http://localhost:3000
DASHBOARD_PORT=3000

# The interface the dashboard port is published on. Defaults to loopback, so a
# fresh install is not exposed to the network before you have an account.
# Docker publishes past host firewalls, so this is the control that matters.
# Set to 0.0.0.0 to expose it, or to a specific address such as 10.0.0.5.
# Which address Docker publishes the dashboard port on. Loopback by default,
# deliberately: Docker publishes straight past ufw and firewalld, so binding
# every interface would put a fresh dashboard on the public internet on a box
# whose firewall looks closed. Set this only to an address you intend to serve
# on, and prefer a reverse proxy with TLS. Changing it changes what agents can
# reach, so re-run scripts/selfhost-setup.sh afterwards to keep
# DASHBOARD_PUBLIC_URL in step.
#DASHBOARD_BIND=127.0.0.1

# OPTIONAL: close signups once your own account exists. Any of 1, true, yes.
#GLASSMKR_DISABLE_REGISTRATION=1

# OPTIONAL: AI analysis. Point at any OpenAI-compatible endpoint (Ollama, vLLM,
# OpenAI, ...). Leave empty and everything else works without it.
#LLM_API_URL=http://host.docker.internal:11434/v1
#LLM_MODEL=llama3.1:8b

# OPTIONAL: outgoing email for alert channels (Resend API key). Empty = no email.
#RESEND_API_KEY=
