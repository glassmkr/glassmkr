# Dashboard environment variables.
#
# In production, these live in /etc/glassmkr/dashboard.env on the production host
# and are loaded by the systemd unit's EnvironmentFile directive. This file
# is the documented template; do NOT commit a real .env.

# === Database ===
# Postgres for state, ClickHouse for telemetry history.
DATABASE_URL=postgres://agent:agent@127.0.0.1:5432/guardian
CLICKHOUSE_URL=http://127.0.0.1:8123

# === Redis (added in PR #1 of the API keys workstream) ===
# Backs rate-limit token buckets and (in PR #3+) audit-log buffered writes.
# Bind redis-server to 127.0.0.1 only; no AUTH because loopback-only.
REDIS_URL=redis://127.0.0.1:6379/0
# Set to 1 in local dev environments without Redis. Rate limit middleware
# degrades open (allows requests). Do NOT set in production.
REDIS_DISABLED=

# === API key pepper (added in PR #1) ===
# Server-side secret for HMAC-SHA256(pepper, plaintext_key). 32+ chars.
# Generate: head -c 48 /dev/urandom | base64 | tr -d '\n'
# See docs/runbooks/key-pepper-rotation.md for rotation procedure.
GLASSMKR_KEY_PEPPER=

# === MCP OAuth and read-only protocol surface ===
# Keep all rollout flags empty until migration 036 is applied and the OAuth
# pepper is installed. Generate an independent 48-byte value for the pepper.
MCP_OAUTH_TOKEN_PEPPER=
MCP_PUBLIC_ORIGIN=https://app.glassmkr.com
MCP_OAUTH_ENABLED=
MCP_READ_ENABLED=
MCP_DYNAMIC_REGISTRATION_ENABLED=
# Optional comma-separated internal IDs for staged rollout. Empty means all.
MCP_ACCOUNT_ALLOWLIST=
MCP_CLIENT_ALLOWLIST=

# === Auth secrets ===
JWT_SECRET=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# === Notifications ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=

# === Misc ===
DASHBOARD_DOMAIN=app.glassmkr.com
HEALTH_CHECK_INTERVAL_MINUTES=5

# === OAuth callback base ===
# Public base URL the OAuth providers should redirect users back to.
# Code fallback (apps/dashboard/src/routes/auth/...) defaults to
# https://app.glassmkr.com, matching post-cutover state. During the
# Phase 3 DNS cutover window, set this to dashboard.glassmkr.com on prod
# to keep the old host's logins working until DNS swaps. Remove the
# override after both DNS and the Google/GitHub OAuth app
# redirect_uri registrations have been updated to app.glassmkr.com.
# OAUTH_CALLBACK_BASE=https://app.glassmkr.com
